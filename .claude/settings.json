{
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(./gradlew checkstyleMain *)",
      "Bash(./gradlew build *)",
      "Bash(docker compose up -d)",
      "Bash(docker compose ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(yarn test *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Bash(mysql *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(aws *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gh pr merge *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./src/main/resources/application-prod.properties)",
      "Write(./src/main/resources/application-prod.properties)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["docker compose up -d", "docker compose ps *", "gh pr create *", "gh pr view *"],
    "filesystem": {
      "allowWrite": ["~/.gradle"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "repo.maven.apache.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "registry.yarnpkg.com",
        "registry.npmjs.org"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "EQUIPMENT_DB_PASSWORD", "mode": "deny" },
        { "name": "EQUIPMENT_MAIL_USER", "mode": "deny" },
        { "name": "EQUIPMENT_MAIL_PASSWORD", "mode": "deny" },
        { "name": "EQUIPMENT_ACTIVE_PROFILE", "mode": "deny" }
      ]
    }
  }
}
